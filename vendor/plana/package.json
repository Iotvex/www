{
    "name": "plana",
    "version": "0.0.0",
    "description": "Apartment plan engine and React view for interactive editors",
    "keywords": [
        "plana",
        "apartment",
        "floor-plan",
        "editor",
        "three",
        "react"
    ],
    "homepage": "https://github.com/xlebpushek/plana#readme",
    "bugs": {
        "url": "https://github.com/xlebpushek/plana/issues",
        "email": "xlebpushek@gmail.com"
    },
    "license": "MIT",
    "author": {
        "name": "Xlebp Rjanoi",
        "email": "xlebpushek@gmail.com",
        "url": "https://github.com/xlebpushek"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/xlebpushek"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xlebpushek/plana.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "format:check": "prettier --check \"index.ts\" \"engine/**/*.{ts,tsx}\" \"react/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"*.config.*\"",
        "format:fix": "prettier --write \"index.ts\" \"engine/**/*.{ts,tsx}\" \"react/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"*.config.*\"",
        "typedoc": "typedoc",
        "clean": "rimraf dist",
        "build": "unbuild",
        "example:tiny": "npx --yes tsx examples/tiny-room.ts",
        "example:apartment": "npx --yes tsx examples/apartment.ts",
        "example:web": "npm run build && npm pack && npm install --prefix examples/web ../plana-0.0.0.tgz && npm run dev --prefix examples/web",
        "example:web:install": "npm install --prefix examples/web",
        "release": "semantic-release"
    },
    "peerDependencies": {
        "@react-three/drei": ">=9",
        "@react-three/fiber": ">=8",
        "react": ">=18",
        "react-dom": ">=18",
        "three": ">=0.160"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "three": {
            "optional": true
        },
        "@react-three/fiber": {
            "optional": true
        },
        "@react-three/drei": {
            "optional": true
        }
    },
    "devDependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.6",
        "@semantic-release/npm": "^12.0.2",
        "@types/node": "^24.12.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@types/three": "^0.185.1",
        "conventional-changelog-conventionalcommits": "^9.3.0",
        "next": "^15.5.22",
        "prettier": "^3.8.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.59.0",
        "semantic-release": "^24.2.9",
        "svgo": "^4.0.1",
        "three": "^0.185.1",
        "typedoc": "^0.28.17",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1"
    },
    "overrides": {
        "rollup": "^4.59.0",
        "svgo": "^4.0.1",
        "tar": "^7.5.4"
    },
    "trustedDependencies": [
        "unrs-resolver"
    ],
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
